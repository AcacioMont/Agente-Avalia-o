function linhasAmostras(data: Dados): Dados[] {
  const homs = lista(data.homogeneizacoes);
  const amostras = lista(data.amostras);

  return amostras.map((a, i) => {
    const h = homs.find((x) => x.amostraId === a.id);
    return {
      Ordem: i + 1,
      Identificador: texto(a.identificador),
      Fonte: texto(a.fonte),
      URL: texto(a.url),
      DataColeta: dataBR(a.dataColeta),
      TipoFonte: texto(a.tipoFonte),
      Bairro: texto(a.bairro),
      SituacaoQuadra: texto(a.situacaoQuadra),
      AreaTerreno_m2: a.areaTerreno ?? null,
      Testada_m: a.testada ?? null,
      Profundidade_m: a.profundidade ?? null,
      AreaEdificada_m2: a.areaEdificada ?? null,
      AreaPrivativa_m2: a.areaPrivativa ?? null,
      Padrao: texto(a.padrao),
      Conservacao: texto(a.conservacao),
      Idade: a.idade ?? null,
      VidaUtil: a.vidaUtil ?? null,
      Elevador: texto(a.elevador),
      Vagas: a.numeroVagas ?? null,
      DistanciaCentro: a.distanciaCentro ?? null,
      ValorOferta: a.valorOferta ?? null,
      ValorTransacao: a.valorTransacao ?? null,
      TipoValor: texto(a.tipoValor),
      Status: texto(a.status),
      Observacoes: texto(a.observacoes),
      ValorUnitarioOriginal: h?.valorUnitarioOriginal ?? null,
      ValorUnitarioHomogeneizado: h?.valorUnitarioHomogeneizado ?? null
    };
  });
}

function linhasHomogeneizacao(data: Dados): Dados[] {
  const amostras = lista(data.amostras);

  return lista(data.homogeneizacoes).map((h, i) => {
    const a = amostras.find((x) => x.id === h.amostraId);
    return {
      Ordem: i + 1,
      Amostra: texto(a?.identificador ?? h.amostraId),
      Bairro: texto(a?.bairro),
      ValorUnitarioOriginal: h.valorUnitarioOriginal,
      FA: h.fa,
      FT: h.ft,
      FP: h.fp,
      FO: h.fo,
      FE: h.fe,
      FI: h.fi,
      FPC: h.fpc,
      FC: h.fc,
      FELEV: h.felev,
      FG: h.fg,
      ProdutoFatores: h.produtoFatores,
      ValorUnitarioHomogeneizado: h.valorUnitarioHomogeneizado,
      MotorVersao: texto(h.motorVersao),
      ParametrosHash: texto(h.parametrosHash),
      CalculadoEm: dataBR(h.calculadoEm),
      AuditoriaCalculo: texto(h.auditoriaJson)
    };
  });
}

function linhasResultado(data: Dados): Dados[] {
  const r = resultadoAtual(data);
  if (!r) return [{ Campo: 'Resultado', Valor: 'Não emitido no snapshot' }];

  return [
    { Campo: 'Método', Valor: texto(r.metodo) },
    { Campo: 'Número de amostras', Valor: texto(r.numeroAmostras) },
    { Campo: 'Valor unitário', Valor: moeda(r.valorUnitario) },
    { Campo: 'Área de referência (m²)', Valor: decimal(r.areaReferencia) },
    { Campo: 'Valor total', Valor: moeda(r.valorTotal) },
    { Campo: 'Média', Valor: moeda(r.media) },
    { Campo: 'Mediana', Valor: moeda(r.mediana) },
    { Campo: 'Desvio padrão', Valor: decimal(r.desvioPadrao, 4) },
    { Campo: 'Coeficiente de variação', Valor: decimal(r.coeficienteVariacao, 4) },
    { Campo: 'Erro padrão', Valor: decimal(r.erroPadrao, 4) },
    { Campo: 'Data do resultado', Valor: dataBR(r.createdAt) }
  ];
}

function linhasSaneamento(data: Dados): Dados[] {
  const s = data.saneamento;
  if (!s) return [{ Campo: 'Saneamento', Valor: 'Não registrado no snapshot' }];

  return [
    { Campo: 'Método', Valor: texto(s.metodo) },
    { Campo: 'Média', Valor: decimal(s.media, 4) },
    { Campo: 'Mediana', Valor: decimal(s.mediana, 4) },
