const root = path.resolve(process.cwd(), '../../reports');
fs.mkdirSync(root, { recursive: true });

type Dados = Record<string, any>;

function texto(v: unknown): string {
  if (v === null || v === undefined || v === '') return 'Não informado';
  if (typeof v === 'boolean') return v ? 'Sim' : 'Não';
  return String(v);
}

function numero(v: unknown): number | null {
  if (v === null || v === undefined || v === '') return null;
  const n = Number(v);
  return Number.isFinite(n) ? n : null;
}

function decimal(v: unknown, casas = 2): string {
  const n = numero(v);
  return n === null
    ? 'Não informado'
    : n.toLocaleString('pt-BR', {
        minimumFractionDigits: casas,
        maximumFractionDigits: casas
      });
}

function moeda(v: unknown): string {
  const n = numero(v);
  return n === null
    ? 'Não informado'
    : n.toLocaleString('pt-BR', {
        style: 'currency',
        currency: 'BRL'
      });
}

function dataBR(v: unknown): string {
  if (!v) return 'Não informado';
  const d = new Date(String(v));
  return Number.isNaN(d.getTime())
    ? texto(v)
    : d.toLocaleDateString('pt-BR');
}

function lista(v: unknown): Dados[] {
  return Array.isArray(v) ? v : [];
}

function resultadoAtual(data: Dados): Dados | undefined {
  const resultados = lista(data.resultados);
  return resultados.length ? resultados[resultados.length - 1] : undefined;
}

function pares(obj: Dados, campos: [string, string][]): Dados[] {
  return campos.map(([titulo, campo]) => ({
    Campo: titulo,
    Valor: texto(obj?.[campo])
  }));
}

async function snap(prisma: PrismaClient, id: string) {
  const [avaliacao, s] = await Promise.all([
    prisma.avaliacao.findUnique({
      where: { id },
      select: { id: true, status: true, snapshotHash: true }
    }),
    getLatestSnapshot(prisma, id)
  ]);

  if (!avaliacao) throw new Error('AVALIACAO_NOT_FOUND');
  if (!s) throw new Error('SNAPSHOT_REQUIRED_BEFORE_EMISSION');
  if (avaliacao.status !== 'PRONTA_PARA_EMISSAO') {
    throw new Error('AVALIACAO_NAO_PRONTA_PARA_EMISSAO');
  }
  if (!avaliacao.snapshotHash || avaliacao.snapshotHash !== s.hashSha256) {
    throw new Error('SNAPSHOT_NAO_VINCULADO_AO_ESTADO_ATUAL');
  }

  const readiness = await new RuleEngine(prisma).auditarAvaliacao(id, {
    exigirSnapshot: true
  });

  if (!readiness.podeEmitir) {
    throw new Error(
      `AVALIACAO_NAO_APTA_PARA_EMISSAO:${JSON.stringify(readiness.alertas)}`
    );
  }

  return { s, data: JSON.parse(s.dadosJson) as Dados };
}

async function saveDocument(
  prisma: PrismaClient,
  id: string,
  formato: 'PDF' | 'DOCX' | 'XLSX',
  tipo: 'LAUDO' | 'PLANILHA',
  buffer: Buffer
) {
  const extensao = formato.toLowerCase();
  const geracao = new Date().toISOString().replace(/[-:.TZ]/g, '');
  const sufixo = crypto.randomBytes(12).toString('hex');
  const nomeArquivo = `laudo-${id}-${geracao}-${sufixo}.${extensao}`;
  const caminho = path.join(root, nomeArquivo);
  const hashSha256 = crypto.createHash('sha256').update(buffer).digest('hex');

  const resultado = await persistArtifactWithCompensation({
    write: () => {
      fs.writeFileSync(caminho, buffer, { flag: 'wx' });
      return caminho;
    },
    persist: (arquivo: string) =>
      prisma.$transaction(async (tx) => {
        const criado = await tx.documento.create({
          data: {
            avaliacaoId: id,
            tipo,
            nomeArquivo,
            caminho: arquivo,
            formato,
            hashSha256
          }
        });

        await tx.auditoria.create({
          data: {
            avaliacaoId: id,
            acao: 'GERACAO_DOCUMENTO',
            entidade: 'Documento',
            entidadeId: criado.id,
            depoisJson: JSON.stringify({
              formato,
              tipo,
              nomeArquivo,
              caminho: arquivo,
              hashSha256
            }),
            usuario: 'sistema',
            motivo: 'Geração de documento do laudo'
          }
        });

        return criado;
      }),
    remove: (arquivo: string) => fs.unlinkSync(arquivo)
  });

  return resultado.record.caminho;
}

